+from shopcart.money import ZERO, round_money, to_money
+
+
+@dataclass(frozen=True)
+class Eligibility:
+    """Conditions a cart must meet before a discount takes anything off."""
+
+    min_subtotal: Decimal = ZERO
+    categories: frozenset | None = None
+
+    def eligible_subtotal(self, cart):
+        """Sum of the lines the discount may be applied to."""
+        total = ZERO
+        for line in cart.lines():
+            if self.categories is None or line.product.category in self.categories:
+                total += line.line_total()
+        return total
 
 
 @dataclass(frozen=True)
@@ -11,6 +27,7 @@ class Discount:
 
     code: str
     percent: Decimal
+    eligibility: Eligibility | None = None
 
     @classmethod
     def from_config(cls, config):
