     return percent
+
+
+def _parse_eligibility(raw):
+    if raw is None:
+        return None
+    if not isinstance(raw, dict):
+        raise InvalidDiscountError("eligibility must be a mapping")
+    min_subtotal = _parse_min_subtotal(raw.get("min_subtotal", "0"))
+    categories = raw.get("categories")
+    if categories is not None:
+        categories = _parse_categories(categories)
+    return Eligibility(min_subtotal=min_subtotal, categories=categories)
+
+
+def _parse_min_subtotal(raw):
+    try:
+        amount = to_money(raw)
+    except (TypeError, ValueError) as exc:
+        raise InvalidDiscountError("eligibility.min_subtotal must be a money value") from exc
+    if amount < 0:
+        raise InvalidDiscountError("eligibility.min_subtotal must not be negative")
+    return amount
+
+
+def _parse_categories(raw):
+    if not isinstance(raw, list) or len(raw) == 0:
+        raise InvalidDiscountError("eligibility.categories must be a non-empty list")
+    for category in raw:
+        if not isinstance(category, str) or not category.strip():
+            raise InvalidDiscountError("eligibility.categories must contain non-blank strings")
+    return frozenset(raw)
